@model Practise_project.Models.ErrorViewModel

<div class="container mt-4 p-4 border border-primary rounded" style="max-width: 1100px; background-color: #fff;">

    <!-- 画面タイトル -->
    <div class="row mb-3">
        <div class="col-12 text-center border p-2 bg-light">
            <h4 class="m-0">Person Search</h4>
        </div>
    </div>

    <!-- エラーメッセージエリア（Validation Summary） -->
    <!-- ※もしエラーがある場合のみ表示。デザインに合わせて背景赤・文字白に設定しています -->
    <div asp-validation-summary="All" class="alert alert-danger text-white bg-danger mb-4" role="alert">
        <h5>エラーメッセージを表示</h5>
    </div>

    <!-- 検索フォーム -->
    <form asp-action="Search" method="get">

        <!-- ボタン配置エリア -->
        <div class="d-flex justify-content-end gap-2 mb-3">
            <button type="submit" class="btn btn-primary px-4 shadow-sm">Search</button>
            <a asp-action="Create" class="btn btn-primary px-4 shadow-sm">New</a>
        </div>

        <!-- 入力フィールド群 -->
        <div class="row g-3 mb-4">
            <!-- Given Name -->
            <div class="col-md-4">
                <div class="row align-items-center">
                    @* <label asp-for="SearchGivenName" class="col-sm-4 col-form-label text-nowrap"> *@
                        Given Name<span class="text-danger">*</span>
                    </label>
                    <div class="col-sm-8">
                        @* <input type="text" asp-for="SearchGivenName" class="form-control border-dark" /> *@
                    </div>
                </div>
            </div>

            <!-- SurName -->
            <div class="col-md-4">
                <div class="row align-items-center">
                    @* <label asp-for="SearchSurName" class="col-sm-4 col-form-label text-nowrap"> *@
                        SurName<span class="text-danger">*</span>
                    </label>
                    <div class="col-sm-8">
                        @* <input type="text" asp-for="SearchSurName" class="form-control border-dark" /> *@
                    </div>
                </div>
            </div>

            <!-- Local Language Name -->
            <div class="col-md-4">
                <div class="row align-items-center">
                    @* <label asp-for="SearchLocalLanguageName" class="col-sm-5 col-form-label text-nowrap">Local Language Name</label> *@
                    <div class="col-sm-7">
                        @* <input type="text" asp-for="SearchLocalLanguageName" class="form-control border-dark" /> *@
                    </div>
                </div>
            </div>

            <!-- Person Type -->
            <div class="col-md-4">
                <div class="row align-items-center">
                    @* <label asp-for="SearchPersonType" class="col-sm-4 col-form-label text-nowrap"> *@
                        Person Type<span class="text-danger">*</span>
                    </label>
                    <div class="col-sm-8">
                       
            <option value="">-- Select --</option> @* <select asp-for="SearchPersonType" class="form-select border-dark" asp-items="Model.PersonTypeOptions"> *@
                        </select>
                    </div>
                </div>
            </div>

            <!-- E-Mail -->
            <div class="col-md-4">
                <div class="row align-items-center">
                    @* <label asp-for="SearchEmail" class="col-sm-4 col-form-label text-nowrap">E-Mail</label> *@
                    <div class="col-sm-8">
                        @* <input type="email" asp-for="SearchEmail" class="form-control border-dark" /> *@
                    </div>
                </div>
            </div>
        </div>
    </form>

    <!-- 検索結果テーブル -->
    <div class="table-responsive mt-4">
        <table class="table table-bordered align-middle text-center">
            <thead class="table-light">
                <tr>
                    <th style="width: 60px;"></th>
                    <th>Given Name</th>
                    <th>SurName</th>
                    <th>Person Type</th>
                    <th>Local Language Name</th>
                    <th>E-Mail</th>
                </tr>
            </thead>
            <tbody>
                @* @if (Model.SearchResults != null && Model.SearchResults.Any()) *@
                @* @if()
                {
                    foreach (var item in ) *@
                    {
                        <tr>
                            @* <td>
                                <a asp-action="Edit" asp-route-id="@item.Id" class="btn btn-link btn-sm p-0">Edit</a>
                            </td> *@
                            <td>GivenName</td>
                            <td>SurName</td>
                            <td>PersonType</td>
                            <td>LocalLanguageName</td>
                            <td>Email</td>
                        </tr>
                    }
                }
                else
                {
                    @* <!-- モックアップ通りの空行（データがない場合のプレースホルダーとして5行表示） -->
                    @for (int i = 0; i < 5; i++)
                    {
                        <tr>
                            <td><a asp-action="Edit" class="btn btn-link btn-sm p-0">Edit</a></td>
                            <td>&nbsp;</td>
                            <td>&nbsp;</td>
                            <td>&nbsp;</td>
                            <td>&nbsp;</td>
                            <td>&nbsp;</td>
                        </tr>
                    } *@
            <tr>
                <td colspan="5" class="text-center text-muted">該当するデータが見つかりません。</td>
            </tr>
                }
            </tbody>
        </table>
    </div>

    <!-- ページネーション -->
    <div class="d-flex justify-content-end mt-2">
        <nav aria-label="Page navigation">
            <ul class="pagination pagination-sm m-0">
                <li class="page-item disabled">
                    <a class="page-item page-link" href="#" tabindex="-1" aria-disabled="true">&larr; Previous</a>
                </li>
                <li class="page-item active"><a class="page-link" href="#">1</a></li>
                <li class="page-item"><a class="page-link" href="#">2</a></li>
                <li class="page-item">
                    <a class="page-link" href="#">Next &rarr;</a>
                </li>
            </ul>
        </nav>
    </div>

</div>