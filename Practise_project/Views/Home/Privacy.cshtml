@model Practise_project.Models.PersonSearchViewModel
@{
    ViewData["Title"] = "Privacy Policy";
}
<h1>@ViewData["Title"]</h1>

<p>Use this page to detail your site's privacy policy.</p>

<hr class="my-4" />

<div class="mt-4">
    <h5 class="mb-3">Quick Links</h5>
    <div class="d-flex gap-3">
        <a asp-controller="Person" asp-action="Create" class="btn btn-outline-primary px-4 shadow-sm">
            <i class="bi bi-search"></i> Go to Person Create
        </a>
        <a asp-controller="Person" asp-action="Search" class="btn btn-outline-primary px-4 shadow-sm">
            <i class="bi bi-search"></i> Go to Person Search
        </a>
    </div>
</div>