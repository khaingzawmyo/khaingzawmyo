@model Practise_project.Models.PersonSearchViewModel

@{
    // ViewData["PersonId"] が 0、もしくは null なら「新規作成モード」、値があれば「編集モード」
    var isNew = ViewData["PersonId"] == null || (int)ViewData["PersonId"] == 0;
}

<div class="container mt-4 p-4 border border-primary rounded" style="max-width: 1200px; background-color: #fff;">

    <div class="row mb-3">
        <div class="col-12 text-center border p-2 bg-light">
            <h4 class="m-0">@(isNew ? "Person Create" : "Person Edit")</h4>
        </div>
    </div>

    @if (!ViewData.ModelState.IsValid)
    {
        <div asp-validation-summary="All" class="alert alert-danger text-white bg-danger mb-4" role="alert" style="border-radius: 0;">
            エラーメッセージを表示
        </div>
    }

    <form asp-action="@(isNew ? "Create" : "Edit")" asp-route-id="@ViewData["PersonId"]" method="post">

        <div class="d-flex justify-content-end gap-2 mb-4">
            @* <button type="submit" class="btn btn-primary px-4 shadow-sm">Save</button> *@
            <button type="submit" class="btn btn-primary px-4 shadow-sm">@(isNew ? "Create" : "Save")</button>

            @if (!isNew)
            {
                <a asp-action="Delete" asp-route-id="@ViewData["PersonId"]" class="btn btn-secondary px-4 shadow-sm">Delete</a>
            }
        </div>

        <div class="row g-3">

            <div class="col-md-4 mb-3">
                <div class="row align-items-center">
                    <label asp-for="SearchPersonType" class="col-sm-4 col-form-label text-nowrap">
                        Person Type<span class="text-danger">*</span>
                    </label>
                    <div class="col-sm-8">
                        <select asp-for="SearchPersonType" class="form-select border-dark" asp-items="Model.PersonTypeOptions" required>
                            <option value=""></option>
                        </select>
                    </div>
                </div>
            </div>
            <div class="col-md-8"></div> <div class="col-md-3">
            <div class="row align-items-center">
                <label asp-for="SearchGivenName" class="col-sm-5 col-form-label text-nowrap">
                    Given Name<span class="text-danger">*</span>
                </label>
                <div class="col-sm-7">
                    <input type="text" asp-for="SearchGivenName" class="form-control border-dark" required />
                </div>
            </div>
        </div>

        <div class="col-md-3">
            <div class="row align-items-center">
                <label asp-for="SearchSurName" class="col-sm-4 col-form-label text-nowrap">
                    SurName<span class="text-danger">*</span>
                </label>
                <div class="col-sm-8">
                    <input type="text" asp-for="SearchSurName" class="form-control border-dark" required />
                </div>
            </div>
        </div>

        <div class="col-md-4">
            <div class="row align-items-center">
                <label asp-for="SearchLocalLanguageName" class="col-sm-6 col-form-label text-nowrap">
                    Local Language Name
                </label>
                <div class="col-sm-6">
                    <input type="text" asp-for="SearchLocalLanguageName" class="form-control border-dark" />
                </div>
            </div>
        </div>

        <div class="col-md-2">
            <div class="row align-items-center">
                <label asp-for="SearchAge" class="col-sm-4 col-form-label text-nowrap">
                    Age
                </label>
                <div class="col-sm-8">
                    <input type="number" asp-for="SearchAge" class="form-control border-dark" />
                    <span asp-validation-for="SearchAge" class="text-danger small"></span>
                </div>
            </div>
        </div>


        <div class="col-md-4 mt-3">
            <div class="row align-items-center">
                <label asp-for="SearchEmail" class="col-sm-4 col-form-label text-nowrap">
                    E-Mail
                </label>
                <div class="col-sm-8">
                    <input type="email" asp-for="SearchEmail" class="form-control border-dark" />
                </div>
            </div>
        </div>
        <div class="col-md-8"></div>

    </div>
</form>
</div>