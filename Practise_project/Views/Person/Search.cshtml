@model Practise_project.Models.PersonSearchViewModel

<div class="container mt-4 p-4 border border-primary rounded" style="max-width: 1100px; background-color: #fff;">

    <div class="row mb-3">
        <div class="col-12 text-center border p-2 bg-light">
            <h4 class="m-0">Person Search</h4>
        </div>
    </div>

    @if (ViewData.ModelState != null && !ViewData.ModelState.IsValid)
    {
        <div asp-validation-summary="All" class="alert alert-danger text-white bg-danger mb-4" role="alert">
            <h5>入力内容を確認してください</h5>
        </div>
    }

    <form asp-action="ExecuteSearch" method="get">
        <div class="d-flex justify-content-end gap-2 mb-3">
            <button type="submit" class="btn btn-primary px-4 shadow-sm">Search</button>
            <a asp-action="Create" class="btn btn-primary px-4 shadow-sm">New</a>
        </div>
        <div class="row g-3 mb-4">
            <div class="col-md-4">
                <div class="row h-100 align-items-end">
                    <label asp-for="SearchGivenName" class="col-sm-4 col-form-label text-nowrap pb-2">
                        Given Name<span class="text-danger">*</span>
                    </label>
                    <div class="col-sm-8 pb-1">
                        <input type="text" asp-for="SearchGivenName" class="form-control border-dark" />
                    </div>
                </div>
            </div>

            <div class="col-md-4">
                <div class="row h-100 align-items-end">
                    <label asp-for="SearchSurName" class="col-sm-4 col-form-label text-nowrap">
                        SurName<span class="text-danger">*</span>
                    </label>
                    <div class="col-sm-8 pb-1">
                        <input type="text" asp-for="SearchSurName" class="form-control border-dark" />
                    </div>
                </div>
            </div>

            <div class="col-md-4">
                <div class="row h-100 align-items-end">
                    <label asp-for="SearchLocalLanguageName" class="col-12 col-form-label text-nowrap pb-1">
                        Local Language Name
                    </label>
                    <div class="col-12 pb-1">
                        <input type="text" asp-for="SearchLocalLanguageName" class="form-control border-dark" />
                    </div>
                </div>
            </div>


            <div class="col-md-4 mt-4">
                <div class="row align-items-center">
                    <label asp-for="SearchPersonType" class="col-sm-4 col-form-label text-nowrap">
                        Person Type<span class="text-danger">*</span>
                    </label>
                    <div class="col-sm-8">
                        <select asp-for="SearchPersonType" class="form-select border-dark" asp-items="Model.PersonTypeOptions">
                            <option value=""></option>
                        </select>
                    </div>
                </div>
            </div>

            <div class="col-md-4 mt-4">
                <div class="row align-items-center">
                    <label asp-for="SearchEmail" class="col-sm-4 col-form-label text-nowrap">
                        E-Mail
                    </label>
                    <div class="col-sm-8">
                        <input type="email" asp-for="SearchEmail" class="form-control border-dark" />
                    </div>
                </div>
            </div>

            <div class="col-md-4 d-none d-md-block"></div>
        </div>
    </form>

    <div class="table-responsive mt-4">
        <table class="table table-bordered align-middle text-center">
            <tbody>
                @if (Model != null && Model.SearchResults != null && Model.SearchResults.Any())
                {
                    foreach (var item in Model.SearchResults)
                    {
                        <tr>
                            <td>
                                <a asp-action="Edit" asp-route-id="@item.Id" class="btn btn-link btn-sm p-0">Edit</a>
                            </td>
                            <td>@item.GivenName</td>
                            <td>@item.SurName</td>
                            <td>@item.PersonType</td>
                            <td>@item.LocalLanguageName</td>
                            <td>@item.Email</td>
                        </tr>
                    }
                }
                else if (Model?.IsSearched == true)
                {
                    @*検索ボタンが押された（IsSearchedがtrue）かつ、データが0件のときだけここを通る *@
                    <tr>
                        <td colspan="5" class="ttext-center text-danger fw-bold">該当するデータが見つかりません。</td>
                    </tr>
                }
                else
                {
                    @*最初に画面を開いた時（まだ検索してない時）ここ表示されます *@
                    <tr>
                        <td colspan="5" class="text-center text-muted">条件を入力して検索してください。</td>
                    </tr>
                }
            </tbody>
        </table>
    </div>

    <div class="d-flex justify-content-end mt-2">
        <nav aria-label="Page navigation">
            <ul class="pagination pagination-sm m-0">
                <li class="page-item disabled">
                    <a class="page-link" href="#" tabindex="-1" aria-disabled="true">&larr; Previous</a>
                </li>
                <li class="page-item active"><a class="page-link" href="#">1</a></li>
                <li class="page-item"><a class="page-link" href="#">2</a></li>
                <li class="page-item">
                    <a class="page-link" href="#">Next &rarr;</a>
                </li>
            </ul>
        </nav>
    </div>
</div>

<link rel="stylesheet" href="https://cdn.datatables.net/1.13.6/css/dataTables.bootstrap5.min.css" />
<script src="https://code.jquery.com/jquery-3.6.0.min.js"></script>
<script src="https://cdn.datatables.net/1.13.6/js/jquery.dataTables.min.js"></script>
<script src="https://cdn.datatables.net/1.13.6/js/dataTables.bootstrap5.min.js"></script>

<script>
    $(document).ready(function () {
        $('#PersonsTable').DataTable({
        "pageLength": 10,       // 1ページに表示する件数を10件に指定
        "lengthChange": true,   // ユーザーが「10件」「25件」と表示件数を変更できるようにするか
        "searching": true,      // テーブル内をキーワードでさらに絞り込める検索窓を出すか
        "ordering": true,       // 各列のヘッダーをクリックしてソートできるようにするか
        "info": true,           // 「XX件中 X〜X件を表示」のテキストを出すか
        "paging": true         // 改ページ（ページネーション）機能を有効にする
        });
    });
</script>