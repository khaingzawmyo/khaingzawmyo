@model Practise_project.Models.InvoiceSearchViewModel
<div class="container mt-4 p-4 border border-primary rounded" style="max-width: 1100px; background-color: #fff;">
    @{
        ViewData["Title"] = "Invoice Search";
    }

    <div class="container mt-4">
        <div class="border text-center py-2 mb-4 bg-light">
            <h5 class="m-0">Invoice Search</h5>
        </div>

        <form asp-controller="Invoice" asp-action="Search" method="post" class="mb-4">
            <div class="d-flex justify-content-end gap-2 mb-4">
                <button type="submit" class="btn btn-primary px-4">Search</button>
                <a asp-controller="Invoice" asp-action="Create" class="btn btn-primary px-4">New</a>
            </div>

            <div asp-validation-summary="ModelOnly" class="text-danger mb-3"></div>

            <div class="row g-3 align-items-center mb-3">
                <div class="col-md-6 d-flex align-items-center">
                    <label asp-for="SearchInvoiceNo" class="form-label me-2 text-nowrap" style="width: 120px;">
                        Invoice No <span class="text-danger">*</span>
                    </label>
                    <div class="w-100">
                        <input type="text" asp-for="SearchInvoiceNo" class="form-control" />
                        <span asp-validation-for="SearchInvoiceNo" class="text-danger small"></span>
                    </div>
                </div>

                <div class="col-md-6 d-flex align-items-center">
                    <label asp-for="SearchCreatePersonId" class="form-label me-2 text-nowrap" style="width: 120px;">
                        Create Person
                    </label>
                    <select asp-for="SearchCreatePersonId" asp-items="Model.CreatePersonOptions" class="form-select">
                        <option value=""></option>
                    </select>
                </div>
            </div>

            <div class="row g-3 align-items-center mb-4">
                <div class="col-md-6 d-flex align-items-center">
                    <label asp-for="SearchCreateDateFrom" class="form-label me-2 text-nowrap" style="width: 120px;">
                        From Create Date
                    </label>
                    <input type="date" asp-for="SearchCreateDateFrom" class="form-control" />
                </div>

                <div class="col-md-6 d-flex align-items-center">
                    <label asp-for="SearchCreateDateTo" class="form-label me-2 text-nowrap" style="width: 120px;">
                        To Create Date
                    </label>
                    <input type="date" asp-for="SearchCreateDateTo" class="form-control" />
                </div>
            </div>

        </form>

        <div class="table-responsive">
      
            <table class="table table-bordered align-middle text-center"> 
                @if (Model.IsSearched && Model.SearchResults != null)
                {
                    if (Model.SearchResults.Any())
                    {
                        <thead class="table-primary">
                            <tr>
                                <th style="width: 80px;"></th>
                                <th>Invoice No</th>
                                <th>Create Person</th>
                                <th>Create Date</th>
                                <th>Remarks</th>
                            </tr>
                        </thead>
                        // 💡 コントローラーで結合したデータをループ表示
                        foreach (var item in Model.SearchResults)
                        {
                            <tbody>
                                <tr>
                                    <td>
                                        <a asp-controller="Invoice" asp-action="Edit" asp-route-id="@item.InvoiceId" class="text-primary text-decoration-underline small">Edit</a>
                                    </td>
                                    <td>@item.InvoiceNo</td>
                                    <td>@item.CreatePersonName</td>
                                    <td>@item.EntryDate.ToString("yyyy/MM/dd")</td>
                                    <td class="text-start">@item.Remarks</td>
                                </tr>
                            </tbody>
                        }
                    }
                    else if (Model?.IsSearched == true)
                    {
                        @*検索ボタンが押された（IsSearchedがtrue）かつ、データが0件のときだけここを通る *@
                        <tbody>
                            <tr>
                                <td colspan="5" class="ttext-center text-danger fw-bold">該当するデータが見つかりません。</td>
                            </tr>
                        </tbody>
                    }
                    else
                    {
                        <tbody>
                            <tr>
                                <td colspan="5" class="text-muted py-3">該当するデータが見つかりませんでした。</td>
                            </tr>
                        </tbody>
                    }
                    
                }
            
            </table>
        </div>
    </div>
</div>

<div class="d-flex justify-content-end mt-2">
    <nav aria-label="Page navigation">
        <ul class="pagination pagination-sm m-0">
            <li class="page-item disabled">
                <a class="page-link" href="#" tabindex="-1" aria-disabled="true">&larr; Previous</a>
            </li>
            <li class="page-item active"><a class="page-link" href="#">1</a></li>
            <li class="page-item"><a class="page-link" href="#">2</a></li>
            <li class="page-item">
                <a class="page-link" href="#">Next &rarr;</a>
            </li>
        </ul>
    </nav>
</div>

<link rel="stylesheet" href="https://cdn.datatables.net/1.13.6/css/dataTables.bootstrap5.min.css" />
<script src="https://code.jquery.com/jquery-3.6.0.min.js"></script>
<script src="https://cdn.datatables.net/1.13.6/js/jquery.dataTables.min.js"></script>
<script src="https://cdn.datatables.net/1.13.6/js/dataTables.bootstrap5.min.js"></script>

<script>
    $(document).ready(function() {
        $('#PersonsTable').DataTable({
            "pageLength": 10,       // 1ページに表示する件数を10件に指定
            "lengthChange": true,   // ユーザーが「10件」「25件」と表示件数を変更できるようにするか
            "searching": true,      // テーブル内をキーワードでさらに絞り込める検索窓を出すか
            "ordering": true,       // 各列のヘッダーをクリックしてソートできるようにするか
            "info": true,           // 「XX件中 X〜X件を表示」のテキストを出すか
            "paging": true         // 改ページ（ページネーション）機能を有効にする
        });
    });
</script>
