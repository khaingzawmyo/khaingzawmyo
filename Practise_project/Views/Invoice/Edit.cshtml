@model Practise_project.Models.InvoiceSearchViewModel

@{
    // ViewData["InvoiceItemId"] が 0、もしくは null なら「新規作成モード」、値があれば「編集モード」
    var isNew = ViewData["InvoiceItemId"] == null || ((int?)ViewData["InvoiceItemId"] ?? 0) == 0;
}

<div class="container mt-4 p-4 border border-primary rounded" style="max-width: 1200px; background-color: #fff;">

    <div class="row mb-3">
        <div class="col-12 text-center border p-2 bg-light">
            <h4 class="m-0">@(isNew ? "Invoice Create" : "Invoice Edit")</h4>
        </div>
    </div>

    @if (!ViewData.ModelState.IsValid)
    {
        <div asp-validation-summary="All" class="alert alert-danger text-white bg-danger mb-4" role="alert" style="border-radius: 0;">
            エラーメッセージを表示
        </div>
    }

    <form asp-action="@(isNew ? "Create" : "Edit")" asp-route-id="@ViewData["InvoiceItemId"]" method="post">

        <!-- 右上アクションボタンエリア -->
        <div class="d-flex justify-content-end gap-2 mb-4">
            <button type="submit" name="action" value="save" class="btn btn-primary px-4 shadow-sm">
                @(isNew ? "Create" : "Save")
            </button>

            @if (!isNew)
            {
                <button type="submit" name="action" value="void" class="btn btn-danger px-4 shadow-sm" onclick="return confirm('本当に削除しますか？');">
                    Void
                </button>
            }

        </div>

        <!-- 入力フォームエリア -->
        <div class="row g-3 mb-4">
            <!-- 左カラム -->
            <div class="col-md-6">
                <!-- ① Invoice No -->
                <div class="row mb-3 align-items-center">
                    <label asp-for="SearchInvoiceNo" class="col-sm-4 col-form-label text-end fw-bold" style="font-size: 0.9rem;">
                        Invoice No<span class="text-danger">*</span>
                    </label>
                    <div class="col-sm-8 position-relative">
                        <input asp-for="SearchInvoiceNo" class="form-control custom-input" />
                        <span asp-validation-for="SearchInvoiceNo" class="text-danger small d-block"></span>
                    </div>
                </div>

                <!-- ③ Customer Name -->
                <div class="row mb-3 align-items-center">
                    <label asp-for="Customer_name" class="col-sm-4 col-form-label text-end fw-bold" style="font-size: 0.9rem;">
                        Customer Name<span class="text-danger">*</span>
                    </label>
                    <div class="col-sm-8">
                        <input asp-for="Customer_name" class="form-control custom-input" />
                        <span asp-validation-for="Customer_name" class="text-danger small d-block"></span>
                    </div>
                </div>

                <!-- ⑤ Total Amount (読み取り専用) -->
                <div class="row mb-3 align-items-center">
                    <label asp-for="Total_amount" class="col-sm-4 col-form-label text-end fw-bold" style="font-size: 0.9rem;">
                        Total Amount<span class="text-danger">*</span>
                    </label>
                    <div class="col-sm-8">
                        <input asp-for="Total_amount" class="form-control custom-input bg-secondary text-white" readonly />
                        <span asp-validation-for="Total_amount" class="text-danger small d-block"></span>
                    </div>
                </div>
            </div>

            <!-- 右カラム -->
            <div class="col-md-6">
                <!-- ② Create Person -->
                <div class="row mb-3 align-items-center">
                    <label asp-for="SearchCreatePersonId" class="col-sm-4 col-form-label text-end fw-bold" style="font-size: 0.9rem;">
                        Create Person<span class="text-danger">*</span>
                    </label>
                    <div class="col-sm-8">
                        <select asp-for="SearchCreatePersonId" asp-items="Model.CreatePersonOptions" class="form-select custom-input">
                            <option value="">▼</option>
                        </select>
                        <span asp-validation-for="SearchCreatePersonId" class="text-danger small d-block"></span>
                    </div>
                </div>

                <!-- ④ Remarks -->
                <div class="row mb-3 align-items-center">
                    <label asp-for="Remarks" class="col-sm-4 col-form-label text-end fw-bold" style="font-size: 0.9rem;">
                        Remarks
                    </label>
                    <div class="col-sm-8">
                        <input asp-for="Remarks" class="form-control custom-input" />
                        <span asp-validation-for="Remarks" class="text-danger small d-block"></span>
                    </div>
                </div>
            </div>
        </div>

        <!-- 明細テーブル ＆ 行操作ボタン -->
        <div class="row align-items-start">
            <!-- テーブル -->
            <div class="col-md-9 col-10">
                <div class="table-responsive">
                    <table class="table table-bordered text-center align-middle m-0" id="detailsTable">
                        <thead class="table-light">
                            <tr>
                                <th style="width: 40%; font-size: 0.9rem;">Charge Desc.</th>
                                <th style="width: 30%; font-size: 0.9rem;">Revenue Amount</th>
                                <th style="width: 30%; font-size: 0.9rem;">Cost Amount</th>
                            </tr>
                        </thead>
                        <tbody>
                            @for (int i = 0; i < Model.Details.Count; i++)
                            {
                                <tr>
                                    <td>
                                        <input asp-for="Details[i].ChargeDesc" class="form-control" />
                                        <span asp-validation-for="Details[i].ChargeDesc" class="text-danger small d-block"></span>
                                    </td>
                                    <td>
                                        <input asp-for="Details[i].RevenueAmount" type="number" class="form-control" />
                                        <span asp-validation-for="Details[i].RevenueAmount" class="text-danger small d-block"></span>
                                    </td>
                                    <td>
                                        <input asp-for="Details[i].CostAmount" type="number" class="form-control" />
                                        <span asp-validation-for="Details[i].CostAmount" class="text-danger small d-block"></span>
                                    </td>
                                </tr>
                            }
                        </tbody>
                    </table>
                </div>
            </div>

            <!-- ＋・ー ボタン -->
            <div class="col-md-1 col-2 d-flex flex-column gap-2" style="max-width: 60px;">
                <button type="button" class="btn btn-outline-dark fw-bold py-2 shadow-sm" id="addRowBtn" style="font-size: 1.2rem; line-height: 1;">＋</button>
                <button type="button" class="btn btn-outline-dark fw-bold py-2 shadow-sm" id="removeRowBtn" style="font-size: 1.2rem; line-height: 1;">－</button>
            </div>
        </div>
    </form>
</div>
<div class="d-flex justify-content-end">
    <a asp-controller="Invoice" asp-action="Search" class="btn btn-outline-secondary px-4 shadow-sm">BACK</a>
    <a asp-controller="Home" asp-action="Privacy" class="btn btn-success px-4 shadow-sm">Home</a>
</div>

<!-- スタイル調整 -->
<style>
    .custom-input {
        border: 1px solid #000 !important;
        border-radius: 0px !important;
        height: 34px;
        padding: 4px 8px;
    }

    #detailsTable, #detailsTable th, #detailsTable td {
        border: 1px solid #000 !important;
    }

        #detailsTable th {
            background-color: #fff !important;
            font-weight: normal;
        }

    .btn {
        border-radius: 4px;
    }
</style>

@section Scripts {
    <script>
        document.getElementById('addRowBtn').addEventListener('click', function() {
            var tableBody = document.querySelector('#detailsTable tbody');
            var rowCount = tableBody.rows.length;
            var newRow = tableBody.insertRow();

            newRow.innerHTML = `
                        <td><input type="text" name="Details[${rowCount}].ChargeDesc" class="form-control form-control-sm border-0 bg-transparent text-center" /></td>
                        <td><input type="number" name="Details[${rowCount}].RevenueAmount" class="form-control form-control-sm border-0 bg-transparent text-center revenue-input" /></td>
                        <td><input type="number" name="Details[${rowCount}].CostAmount" class="form-control form-control-sm border-0 bg-transparent text-center" /></td>
                    `;
        });

        document.getElementById('removeRowBtn').addEventListener('click', function() {
            var tableBody = document.querySelector('#detailsTable tbody');
            if (tableBody.rows.length > 1) {
                tableBody.deleteRow(-1);
            }
        });
    </script>
}